# Supabase Configuration
# Get these values from your Supabase project dashboard:
# https://app.supabase.com → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (SERVER-ONLY — never prefix with NEXT_PUBLIC_).
# Used by the investor portal routes (/api/portal/*) to compute a single
# investor's ownership/profit from all partners on the server, while returning
# only that investor's own data. Find it in:
# Supabase dashboard → Project → Settings → API → service_role secret.
# Treat it like a password: it bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Gmail SMTP Configuration
# Used by /api/reports/send-monthly to email PDF reports to partners.
# The Gmail account is the sender; recipients see this address in the
# From field.
#
# 1. Enable 2-Step Verification on the Gmail account
#    https://myaccount.google.com/security
# 2. Generate an App Password (16 chars, no spaces needed)
#    https://myaccount.google.com/apppasswords
# 3. Paste them below.
GMAIL_USER=your.address@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop
