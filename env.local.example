# Supabase Configuration
# Get these values from your Supabase project dashboard:
# https://app.supabase.com → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Resend (Email) Configuration
# Used by /api/reports/send-monthly to email PDF reports to partners.
# Get your API key from https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender address. To send to addresses other than your own Resend
# account email, you must verify a domain at
# https://resend.com/domains. If unset, the route falls back to
# `onboarding@resend.dev` (works only for the email registered on
# your Resend account).
RESEND_FROM_EMAIL=reports@yourdomain.com
