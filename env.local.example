# Supabase Configuration
# Get these values from your Supabase project dashboard:
# https://app.supabase.com → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Gmail SMTP Configuration
# Used by /api/reports/send-monthly to email PDF reports to partners.
# The Gmail account is the sender; recipients see this address in the
# From field.
#
# 1. Enable 2-Step Verification on the Gmail account
#    https://myaccount.google.com/security
# 2. Generate an App Password (16 chars, no spaces needed)
#    https://myaccount.google.com/apppasswords
# 3. Paste them below.
GMAIL_USER=your.address@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop

# ── Partner authentication ─────────────────────────────────────────
# Service-role key (Supabase → Project Settings → API → service_role).
# SERVER-ONLY: used by /api/admin/partner-accounts (account creation)
# and /api/reports/send-monthly after RLS lockdown. NEVER prefix it
# with NEXT_PUBLIC_ and never put it in the APK build.
SUPABASE_SERVICE_ROLE_KEY=

# Flip to 1 ONLY after partner accounts exist and migration 013 has
# run — the app then requires sign-in (GP sees everything, each LP
# sees their own details page). Empty = auth guard dormant.
NEXT_PUBLIC_AUTH_ENFORCED=

# Optional shared secret for /api/reports/send-monthly. When set, the
# same value must arrive in the x-report-secret request header.
REPORT_SECRET=
