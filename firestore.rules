rules_version = '2';

// Access model — identical to the Supabase RLS this replaces:
//   • Any signed-in partner READS partners / trades / active_stocks
//     (the profit engine needs the full partner list to compute any
//     single partner's share; co-investors already know each other).
//   • transactions is the exception: an LP reads ONLY their own rows.
//   • Only the GP WRITES anything. Anonymous users get nothing.
//
// Identity comes from custom claims stamped by the migration script /
// the admin accounts API:  gp: boolean, partnerId: string.
//
// Deploy: Firebase console → Firestore Database → Rules → paste → Publish.

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isGP() {
      return signedIn() && request.auth.token.gp == true;
    }

    match /partners/{id} {
      allow read: if signedIn();
      allow write: if isGP();
    }

    match /trades/{id} {
      allow read: if signedIn();
      allow write: if isGP();
    }

    match /active_stocks/{id} {
      allow read: if signedIn();
      allow write: if isGP();
    }

    match /transactions/{id} {
      allow read: if isGP()
        || (signedIn() && resource.data.investorId == request.auth.token.partnerId);
      allow write: if isGP();
    }

    // Undo journal — GP only (it holds every partner's snapshots).
    match /operations/{id} {
      allow read, write: if isGP();
    }

    // Frozen monthly-profit records. GP writes/reads all; an LP may read
    // only their own month rows (same shape as transactions).
    match /monthly_profits/{id} {
      allow read: if isGP()
        || (signedIn() && resource.data.partnerId == request.auth.token.partnerId);
      allow write: if isGP();
    }

    // Daily snapshots of the open stock book — what makes day-over-day
    // stock moves computable. Fund-wide (no per-partner data), so any
    // signed-in partner may read; only the GP writes.
    match /daily_snapshots/{id} {
      allow read: if signedIn();
      allow write: if isGP();
    }

    // Anything else: denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
